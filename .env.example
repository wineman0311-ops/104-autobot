# ── 104 Account ──────────────────────────────────────────────────────────────
ACCOUNT_EMAIL=your_104_email@example.com
ACCOUNT_PASSWORD=your_104_password

# ── Corporate Auth State (Zeabur) ─────────────────────────────────────────────
# Run `py encode_auth.py` locally to generate this value.
# Paste the base64 output here on the Zeabur environment variables dashboard.
CORP_AUTH_STATE_JSON=

# ── Telegram Bot ──────────────────────────────────────────────────────────────
TG_BOT_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_CHAT_ID=your_personal_chat_id

# ── Scheduler ─────────────────────────────────────────────────────────────────
SCHEDULE_TIME=09:00
SCHEDULE_TIMEZONE=Asia/Taipei

# ── Database ──────────────────────────────────────────────────────────────────
DB_PATH=warden.db

# ── Browser ───────────────────────────────────────────────────────────────────
HEADLESS=true

# ── Limits (for when ASM is activated) ───────────────────────────────────────
DAILY_MSG_LIMIT=30
MAX_SEARCH_RESULTS=50
